<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DHRustDemo</AssemblyName>
    <RootNamespace>DHRustDemo</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- 引用 DH.NCore NuGet 发布包（与 DHDeploy 产品同版本）：配置（Setting/Config/IConfigProvider）与定时（TimerX/Cron） -->
  <ItemGroup>
    <PackageReference Include="DH.NCore" Version="4.25.2026.911-beta0202" />
  </ItemGroup>

</Project>
